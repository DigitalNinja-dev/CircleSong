# Installed rather than committed.
node_modules/

# Generated: `npm run build:www` assembles it, Capacitor copies it into the
# native project. The sources it is built from are what live here.
www/

# Android build output and local machine state. The project itself is committed
# so that signing config, the manifest and the icons are versioned.
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
*.apk
*.aab
*.keystore
# …except the debug key, which is committed on purpose so that every test build
# carries the same signature and installs over the last one. It is not a secret:
# it holds Android's own published debug credentials and can only ever sign a
# debug build. The release key is a different thing entirely and never comes
# near this repository — see android/app/build.gradle.
!android/debug.keystore

# Generated by `npm run i18n:dump` — the catalogue is derived from the source,
# not a source of truth, and regenerating it is one command.
i18n-catalogue.txt
i18n-missing-*.txt

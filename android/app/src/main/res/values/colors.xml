<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The one ground colour, shared with the web manifest, the splash and the
         window background so launching the app never flashes white. Capacitor
         scaffolds ic_launcher_background into its own values file; that file is
         deleted rather than edited, because two definitions of one colour is a
         duplicate resource and fails the merge. -->
    <color name="ic_launcher_background">#0d0d0d</color>
    <color name="colorPrimary">#0d0d0d</color>
    <color name="colorPrimaryDark">#0d0d0d</color>
    <color name="colorAccent">#8ef000</color>
    <color name="splashBackground">#0d0d0d</color>
</resources>

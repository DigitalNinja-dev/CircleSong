<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      The activity theme. Capacitor sets this on the activity and on the
      application, so it is also the theme every native control the WebView
      puts up is built against — which on Android means the <select> popups.

      Fixed dark rather than DayNight, so that whatever native surface the
      system does put up matches an app that ships dark and defaults to dark,
      rather than following the phone.

      The app's dropdowns no longer come through here at all. They were
      framework dialogs built from this theme, and they arrived unreadable
      twice — dark text on a dark panel, then a white sheet with no legible
      rows — with no way to reproduce or measure either from a browser. They
      are drawn by the page now (src/menu.js), which is themed, translated and
      testable. An alertDialogTheme was pinned here for a while to fix the
      first of those; it is gone, because guessing at a surface nothing here
      can see was how the second one happened.

      There is deliberately no android:background here. As a theme attribute it
      leaks into views that do not set their own, popup rows among them, and it
      was doing nothing that android:windowBackground does not do properly.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- The window sits behind the WebView while it paints. Left null it is
             white, which reads as a flash on every launch of a dark app. -->
        <item name="android:windowBackground">@color/splashBackground</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
